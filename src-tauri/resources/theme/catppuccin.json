{
  "name": "Catppuccin",
  "author": "test",
  "version": "1.0.0",
  "cssContent": "body.theme-light {\n  color-scheme: light;\n\n  /* =========================================================\n     Catppuccin Latte\n     https://github.com/catppuccin/palette\n     ========================================================= */\n\n  /* 00~100 Grayscale */\n  --color-00: #eff1f5; /* Base */\n  --color-05: #e6e9ef; /* Mantle */\n  --color-10: #dce0e8; /* Crust */\n  --color-20: #ccd0da; /* Surface 0 */\n  --color-30: #bcc0cc; /* Surface 1 */\n  --color-40: #acb0be; /* Surface 2 */\n  --color-50: #8c8fa1; /* Overlay 1 */\n  --color-70: #6c6f85; /* Subtext 0 */\n  --color-80: #4c4f69; /* Text */\n  --color-100: #1e1e2e; /* Dark fallback */\n\n  /* Accent Colors */\n  --color-red-rgb: 210, 15, 57;\n  --color-red: #d20f39;\n\n  --color-orange-rgb: 254, 100, 11;\n  --color-orange: #fe640b;\n\n  --color-yellow-rgb: 223, 142, 29;\n  --color-yellow: #df8e1d;\n\n  --color-green-rgb: 64, 160, 43;\n  --color-green: #40a02b;\n\n  --color-cyan-rgb: 4, 165, 229;\n  --color-cyan: #04a5e5;\n\n  --color-blue-rgb: 30, 102, 245;\n  --color-blue: #1e66f5;\n\n  --color-purple-rgb: 136, 57, 239;\n  --color-purple: #8839ef;\n\n  --color-pink-rgb: 234, 118, 203;\n  --color-pink: #ea76cb;\n\n\n  /* =========================================================\n     Backgrounds & Borders\n     ========================================================= */\n\n  --background-primary: #eff1f5; /* Base */\n  --background-secondary: #e6e9ef; /* Mantle */\n\n  --sidebar-bg: #e6e9ef;\n\n  --card-bg: #ffffff;\n  --card-hover-bg: #f4f5f8;\n\n  --card-border-color: rgba(140, 143, 161, 0.25);\n\n  --card-box-shadow:\n    0 4px 16px rgba(76, 79, 105, 0.10);\n\n  --button-bg: #e6e9ef;\n\n  --border-color: #ccd0da;\n  --border-strong-color: #bcc0cc;\n\n\n  /* =========================================================\n     Icons\n     ========================================================= */\n\n  --icon-color: #6c6f85;\n  --indicator-color: #9ca0b0;\n\n  --fill-color: #4c4f69;\n\n  --icon-hover-color: #1e1e2e;\n  --icon-hover-bg: #dce0e8;\n\n\n  /* =========================================================\n     Components\n     ========================================================= */\n\n  --track-bg-color: #dce0e8;\n\n  --badge-bg: #ccd0da;\n  --badge-color: #5c5f77;\n\n\n  /* =========================================================\n     Message Bubble\n     ========================================================= */\n\n  --bubble-bg: #eff1f5;\n  --bubble-border-color: #ccd0da;\n\n  --user-bubble-bg: #e6e9ef;\n  --user-bubble-border-color: #bcc0cc;\n\n  --assistant-bubble-bg: #e6e9ef;\n\n\n  /* =========================================================\n     Typography & Accent\n     ========================================================= */\n\n  --accent-color: #8839ef; /* Mauve */\n  --accent-color-hover: #7b2ed8;\n\n  --text-accent: #4c4f69;\n\n  --text-color: #4c4f69;\n  --text-muted: #6c6f85;\n\n  --text-italic: #8c8fa1;\n  --text-faint: #acb0be;\n\n\n  /* =========================================================\n     Navigation\n     ========================================================= */\n\n  --nav-bg-hover: rgba(136, 57, 239, 0.08);\n  --nav-bg-active: rgba(136, 57, 239, 0.14);\n\n  --nav-text: #6c6f85;\n  --nav-text-active: #8839ef;\n\n\n  /* =========================================================\n     Input\n     ========================================================= */\n\n  --input-color: #4c4f69;\n\n\n  /* =========================================================\n     Scroll / Selection\n     ========================================================= */\n\n  --scrollbar-thumb-color: #9ca0b0;\n\n  --text-highlight-bg: rgba(136, 57, 239, 0.16);\n\n\n  /* =========================================================\n     Shadow\n     ========================================================= */\n\n  --shadow-sm:\n    0 1px 2px rgba(76, 79, 105, 0.08);\n\n  --shadow:\n    0 4px 12px rgba(76, 79, 105, 0.10),\n    0 0 0 1px rgba(76, 79, 105, 0.04);\n\n  --shadow-lg:\n    0 12px 32px rgba(76, 79, 105, 0.14),\n    0 0 0 1px rgba(76, 79, 105, 0.05);\n}\nbody.theme-dark {\n  color-scheme: dark;\n\n  /* =========================================================\n     Catppuccin Mocha\n     ========================================================= */\n\n  /* 00~100 Grayscale */\n  --color-00: #11111b; /* Crust */\n  --color-05: #181825; /* Mantle */\n  --color-10: #1e1e2e; /* Base */\n  --color-20: #313244; /* Surface 0 */\n  --color-30: #45475a; /* Surface 1 */\n  --color-40: #585b70; /* Surface 2 */\n  --color-50: #7f849c; /* Overlay 1 */\n  --color-70: #a6adc8; /* Subtext 0 */\n  --color-80: #cdd6f4; /* Text */\n  --color-100: #ffffff;\n\n  /* Accent Colors */\n  --color-red-rgb: 243, 139, 168;\n  --color-red: #f38ba8;\n\n  --color-orange-rgb: 250, 179, 135;\n  --color-orange: #fab387;\n\n  --color-yellow-rgb: 249, 226, 175;\n  --color-yellow: #f9e2af;\n\n  --color-green-rgb: 166, 227, 161;\n  --color-green: #a6e3a1;\n\n  --color-cyan-rgb: 137, 220, 235;\n  --color-cyan: #89dceb;\n\n  --color-blue-rgb: 137, 180, 250;\n  --color-blue: #89b4fa;\n\n  --color-purple-rgb: 203, 166, 247;\n  --color-purple: #cba6f7;\n\n  --color-pink-rgb: 245, 194, 231;\n  --color-pink: #f5c2e7;\n\n\n  /* =========================================================\n     Backgrounds & Borders\n     ========================================================= */\n\n  --background-primary: #1e1e2e; /* Base */\n  --background-secondary: #181825; /* Mantle */\n\n  --sidebar-bg: #181825;\n\n  --card-bg: #242438;\n  --card-hover-bg: #2a2a40;\n\n  --card-border-color: rgba(205, 214, 244, 0.08);\n\n  --card-box-shadow:\n    0 4px 16px rgba(0, 0, 0, 0.22);\n\n  --button-bg: #313244;\n\n  --border-color: #313244;\n  --border-strong-color: #45475a;\n\n\n  /* =========================================================\n     Icons\n     ========================================================= */\n\n  --icon-color: #a6adc8;\n  --indicator-color: #7f849c;\n\n  --fill-color: #cdd6f4;\n\n  --icon-hover-color: #f5e0dc;\n  --icon-hover-bg: #313244;\n\n\n  /* =========================================================\n     Components\n     ========================================================= */\n\n  --track-bg-color: #313244;\n\n  --badge-bg: #45475a;\n  --badge-color: #cdd6f4;\n\n\n  /* =========================================================\n     Message Bubble\n     ========================================================= */\n\n  --bubble-bg: #242438;\n  --bubble-border-color: #313244;\n\n  --user-bubble-bg: #313244;\n  --user-bubble-border-color: #45475a;\n\n  --assistant-bubble-bg: #181825;\n\n\n  /* =========================================================\n     Typography & Accent\n     ========================================================= */\n\n  --accent-color: #cba6f7; /* Mauve */\n  --accent-color-hover: #d8b8ff;\n\n  --text-accent: #f5e0dc;\n\n  --text-color: #cdd6f4;\n  --text-muted: #a6adc8;\n\n  --text-italic: #9399b2;\n  --text-faint: #6c7086;\n\n\n  /* =========================================================\n     Navigation\n     ========================================================= */\n\n  --nav-bg-hover: rgba(203, 166, 247, 0.10);\n  --nav-bg-active: rgba(203, 166, 247, 0.18);\n\n  --nav-text: #a6adc8;\n  --nav-text-active: #cba6f7;\n\n\n  /* =========================================================\n     Input\n     ========================================================= */\n\n  --input-color: #cdd6f4;\n\n\n  /* =========================================================\n     Scroll / Selection\n     ========================================================= */\n\n  --scrollbar-thumb-color: #585b70;\n\n  --text-highlight-bg: rgba(203, 166, 247, 0.25);\n\n\n  /* =========================================================\n     Shadow\n     ========================================================= */\n\n  --shadow-sm:\n    0 1px 2px rgba(0, 0, 0, 0.25);\n\n  --shadow:\n    0 4px 12px rgba(0, 0, 0, 0.32),\n    0 0 0 1px rgba(205, 214, 244, 0.025);\n\n  --shadow-lg:\n    0 12px 32px rgba(0, 0, 0, 0.45),\n    0 0 0 1px rgba(205, 214, 244, 0.035);\n}"
}