{"name":"Monotone","author":"test","version":"1.0.0","cssContent":"body.theme-light {\n  color-scheme: light;\n\n  /* =========================================================\n     Monotone Light\n     Pure grayscale\n     ========================================================= */\n\n  /* 00~100 Grayscale */\n  --color-00: #ffffff;\n  --color-05: #fafafa;\n  --color-10: #f5f5f5;\n  --color-20: #eeeeee;\n  --color-30: #e0e0e0;\n  --color-40: #bdbdbd;\n  --color-50: #8a8a8a;\n  --color-70: #616161;\n  --color-80: #3d3d3d;\n  --color-100: #181818;\n\n\n  /* =========================================================\n     Accent Colors\n     상태 색상도 최대한 절제된 모노톤\n     ========================================================= */\n\n  --color-red-rgb: 220, 53, 69;\n  --color-red: #dc3545;\n\n  --color-orange-rgb: 253, 126, 20;\n  --color-orange: #fd7e14;\n\n  --color-yellow-rgb: 255, 193, 7;\n  --color-yellow: #ffc107;\n\n  --color-green-rgb: 40, 167, 69;\n  --color-green: #28a745;\n\n  --color-cyan-rgb: 23, 162, 184;\n  --color-cyan: #17a2b8;\n\n  --color-blue-rgb: 0, 123, 255;\n  --color-blue: #007bff;\n\n  --color-purple-rgb: 111, 66, 193;\n  --color-purple: #6f42c1;\n\n  --color-pink-rgb: 214, 51, 132;\n  --color-pink: #d63384;\n\n\n  /* =========================================================\n     Backgrounds & Borders\n     ========================================================= */\n\n  --background-primary: #f5f5f5;\n  --background-secondary: #fafafa;\n\n  --sidebar-bg: #f0f0f0;\n\n  --card-bg: #ffffff;\n  --card-hover-bg: #f7f7f7;\n\n  --card-border-color: rgba(0, 0, 0, 0.08);\n\n  --card-box-shadow:\n    0 4px 16px rgba(0, 0, 0, 0.06);\n\n  --button-bg: #f0f0f0;\n\n  --border-color: #dedede;\n  --border-strong-color: #c7c7c7;\n\n\n  /* =========================================================\n     Icons\n     ========================================================= */\n\n  --icon-color: #666666;\n  --indicator-color: #9a9a9a;\n\n  --fill-color: #181818;\n\n  --icon-hover-color: #181818;\n  --icon-hover-bg: #e8e8e8;\n\n\n  /* =========================================================\n     Components\n     ========================================================= */\n\n  --track-bg-color: #e8e8e8;\n\n  --badge-bg: #e5e5e5;\n  --badge-color: #555555;\n\n\n  /* =========================================================\n     Message Bubble\n     ========================================================= */\n\n  --bubble-bg: #ffffff;\n  --bubble-border-color: #dedede;\n\n  --user-bubble-bg: #eeeeee;\n  --user-bubble-border-color: #d8d8d8;\n\n  --assistant-bubble-bg: #f7f7f7;\n\n\n  /* =========================================================\n     Typography & Accent\n     ========================================================= */\n\n  --accent-color: #3d3d3d;\n  --accent-color-hover: #181818;\n\n  --text-accent: #181818;\n\n  --text-color: #242424;\n  --text-muted: #737373;\n\n  --text-italic: #929292;\n  --text-faint: #b5b5b5;\n\n\n  /* =========================================================\n     Navigation\n     ========================================================= */\n\n  --nav-bg-hover: rgba(0, 0, 0, 0.04);\n  --nav-bg-active: rgba(0, 0, 0, 0.08);\n\n  --nav-text: #737373;\n  --nav-text-active: #181818;\n\n\n  /* =========================================================\n     Input\n     ========================================================= */\n\n  --input-color: #242424;\n\n\n  /* =========================================================\n     Scroll / Selection\n     ========================================================= */\n\n  --scrollbar-thumb-color: #b0b0b0;\n\n  --text-highlight-bg: #dedede;\n\n\n  /* =========================================================\n     Shadow\n     ========================================================= */\n\n  --shadow-sm:\n    0 1px 2px rgba(0, 0, 0, 0.05);\n\n  --shadow:\n    0 4px 12px rgba(0, 0, 0, 0.08),\n    0 0 0 1px rgba(0, 0, 0, 0.03);\n\n  --shadow-lg:\n    0 12px 32px rgba(0, 0, 0, 0.12),\n    0 0 0 1px rgba(0, 0, 0, 0.04);\n}\nbody.theme-dark {\n  color-scheme: dark;\n\n  /* =========================================================\n     Monotone Dark\n     Pure grayscale / charcoal\n     ========================================================= */\n\n  /* 00~100 Grayscale */\n  --color-00: #111111;\n  --color-05: #161616;\n  --color-10: #1c1c1c;\n  --color-20: #262626;\n  --color-30: #333333;\n  --color-40: #4d4d4d;\n  --color-50: #737373;\n  --color-70: #a3a3a3;\n  --color-80: #d1d1d1;\n  --color-100: #f5f5f5;\n\n\n  /* =========================================================\n     Accent Colors\n     모든 상태색을 grayscale로 통일\n     ========================================================= */\n\n  --color-red-rgb: 255, 107, 107;\n  --color-red: #ff6b6b;\n\n  --color-orange-rgb: 255, 159, 67;\n  --color-orange: #ff9f43;\n\n  --color-yellow-rgb: 255, 212, 59;\n  --color-yellow: #ffd43b;\n\n  --color-green-rgb: 81, 207, 102;\n  --color-green: #51cf66;\n\n  --color-cyan-rgb: 34, 211, 238;\n  --color-cyan: #22d3ee;\n\n  --color-blue-rgb: 77, 171, 247;\n  --color-blue: #4dabf7;\n\n  --color-purple-rgb: 151, 117, 250;\n  --color-purple: #9775fa;\n\n  --color-pink-rgb: 240, 101, 149;\n  --color-pink: #f06595;\n\n\n  /* =========================================================\n     Backgrounds & Borders\n     ========================================================= */\n\n  --background-primary: #181818;\n  --background-secondary: #202020;\n\n  --sidebar-bg: #151515;\n\n  --card-bg: #242424;\n  --card-hover-bg: #2b2b2b;\n\n  --card-border-color: rgba(255, 255, 255, 0.08);\n\n  --card-box-shadow:\n    0 4px 16px rgba(0, 0, 0, 0.28);\n\n  --button-bg: #2a2a2a;\n\n  --border-color: #383838;\n  --border-strong-color: #505050;\n\n\n  /* =========================================================\n     Icons\n     ========================================================= */\n\n  --icon-color: #a3a3a3;\n  --indicator-color: #707070;\n\n  --fill-color: #f5f5f5;\n\n  --icon-hover-color: #ffffff;\n  --icon-hover-bg: #333333;\n\n\n  /* =========================================================\n     Components\n     ========================================================= */\n\n  --track-bg-color: #2b2b2b;\n\n  --badge-bg: #383838;\n  --badge-color: #d1d1d1;\n\n\n  /* =========================================================\n     Message Bubble\n     ========================================================= */\n\n  --bubble-bg: #242424;\n  --bubble-border-color: #383838;\n\n  --user-bubble-bg: #303030;\n  --user-bubble-border-color: #454545;\n\n  --assistant-bubble-bg: #202020;\n\n\n  /* =========================================================\n     Typography & Accent\n     ========================================================= */\n\n  --accent-color: #d1d1d1;\n  --accent-color-hover: #ffffff;\n\n  --text-accent: #ffffff;\n\n  --text-color: #e5e5e5;\n  --text-muted: #a3a3a3;\n\n  --text-italic: #808080;\n  --text-faint: #5f5f5f;\n\n\n  /* =========================================================\n     Navigation\n     ========================================================= */\n\n  --nav-bg-hover: rgba(255, 255, 255, 0.06);\n  --nav-bg-active: rgba(255, 255, 255, 0.10);\n\n  --nav-text: #a3a3a3;\n  --nav-text-active: #ffffff;\n\n\n  /* =========================================================\n     Input\n     ========================================================= */\n\n  --input-color: #e5e5e5;\n\n\n  /* =========================================================\n     Scroll / Selection\n     ========================================================= */\n\n  --scrollbar-thumb-color: #505050;\n\n  --text-highlight-bg: rgba(255, 255, 255, 0.14);\n\n\n  /* =========================================================\n     Shadow\n     ========================================================= */\n\n  --shadow-sm:\n    0 1px 2px rgba(0, 0, 0, 0.30);\n\n  --shadow:\n    0 4px 12px rgba(0, 0, 0, 0.35),\n    0 0 0 1px rgba(255, 255, 255, 0.025);\n\n  --shadow-lg:\n    0 12px 32px rgba(0, 0, 0, 0.50),\n    0 0 0 1px rgba(255, 255, 255, 0.035);\n}"}