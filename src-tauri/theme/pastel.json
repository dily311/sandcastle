{
  "name": "Pastel",
  "author": "test",
  "version": "1.0.0",
  "cssContent": "body {\n    /* =========================================================\n   Grayscale\n   밝은 순 -> 어두운 순\n   전체 UI의 #e2e4f6 / #f0f0ff 계열과 어울리는 쿨톤 Gray\n   ========================================================= */\n\n    --color-00: #ffffff;\n    --color-05: #fafaff;\n    --color-10: #f4f5fb;\n    --color-20: #eef0f7;\n    --color-30: #dbe0f0;\n    --color-40: #b7bbcc;\n    --color-50: #8c8ca1;\n    --color-70: #6b6b85;\n    --color-80: #4a4a68;\n    --color-100: #2d2d42;\n\n\n    /* =========================================================\n   Accent Colors\n   상태 표시용\n   ========================================================= */\n\n    --color-red-rgb: 220, 53, 69;\n    --color-red: #dc3545;\n\n    --color-orange-rgb: 253, 126, 20;\n    --color-orange: #fd7e14;\n\n    --color-yellow-rgb: 255, 193, 7;\n    --color-yellow: #ffc107;\n\n    --color-green-rgb: 40, 167, 69;\n    --color-green: #28a745;\n\n    --color-cyan-rgb: 23, 162, 184;\n    --color-cyan: #17a2b8;\n\n    --color-blue-rgb: 86, 117, 255;\n    --color-blue: #5675ff;\n\n    --color-purple-rgb: 139, 133, 249;\n    --color-purple: #8b85f9;\n\n    --color-pink-rgb: 255, 133, 162;\n    --color-pink: #ff85a2;\n\n\n    /* =========================================================\n   Backgrounds & Borders\n   ========================================================= */\n\n    /* 전체 앱 배경 */\n    --background-primary: #e2e4f6;\n\n    /* 사이드바 / 입력 영역 / 보조 영역 */\n    --background-secondary: #f0f0ff;\n\n    --sidebar-bg: #f0f0ff;\n\n    /* 컨텐츠 영역 */\n    --card-bg: #ffffff;\n\n    /* 카드 hover */\n    --card-hover-bg: #fafaff;\n\n    /* 카드 */\n    --card-border-color: rgba(219, 224, 240, 0.7);\n    --card-box-shadow: 0 4px 16px rgba(160, 165, 210, 0.15);\n\n    /* 버튼 */\n    --btn-bg: #f0f2fb;\n\n    /* Border */\n    --border-color: #dbe0f0;\n    --border-strong-color: #cbd1e5;\n\n\n    /* =========================================================\n   Icons\n   ========================================================= */\n\n    --icon-color: #6b6b85;\n    --indicator-color: #a6a7bb;\n\n    --fill-color: #4a4a68;\n\n    --icon-hover-color: #4a4a68;\n    --icon-hover-bg: #e6e8f5;\n\n\n    /* =========================================================\n   Misc Components\n   ========================================================= */\n\n    --track-bg-color: #e8eaf5;\n\n    --badge-bg: #e7e8f4;\n    --badge-color: #6b6b85;\n\n\n    /* =========================================================\n   Message Bubble\n   ========================================================= */\n\n    --bubble-bg: #ffffff;\n    --bubble-border-color: #dbe0f0;\n\n    /* 기본 user bubble */\n    --user-bubble-bg: #eef0f7;\n    --user-bubble-border-color: #dbe0f0;\n\n    /* assistant */\n    --assistant-bubble-bg: #f7f7ff;\n\n\n    /* =========================================================\n   Typography & Accent\n   ========================================================= */\n\n    --accent-color: #8b85f9;\n    --accent-color-hover: #7871ed;\n\n    /* accent 강조 텍스트 */\n    --text-accent: #4a4a68;\n\n    /* 메인 텍스트 */\n    --text-color: #4a4a68;\n\n    /* 보조 텍스트 */\n    --text-muted: #8c8ca1;\n\n    /* italic */\n    --text-italic: #9898ac;\n\n    /* 매우 흐린 텍스트 */\n    --text-faint: #b7b8c8;\n\n\n    /* =========================================================\n   Navigation\n   ========================================================= */\n\n    --nav-bg-hover: rgba(139, 133, 249, 0.08);\n\n    --nav-bg-active: rgba(139, 133, 249, 0.14);\n\n    --nav-text: #8c8ca1;\n\n    --nav-text-active: #5d57d6;\n\n\n    /* =========================================================\n   Input\n   ========================================================= */\n\n    --input-color: #4a4a68;\n\n\n    /* =========================================================\n   Scroll / Selection\n   ========================================================= */\n\n    --scrollbar-thumb-color: #b7bbcc;\n\n    --text-highlight-bg: rgba(139, 133, 249, 0.18);\n\n\n    /* =========================================================\n   Shadow\n   ========================================================= */\n\n    --shadow-sm:\n        0 1px 2px rgba(100, 105, 150, 0.08);\n\n    --shadow:\n        0 4px 12px rgba(120, 125, 175, 0.10),\n        0 0 0 1px rgba(160, 165, 210, 0.08);\n\n    --shadow-lg:\n        0 12px 32px rgba(120, 125, 175, 0.14),\n        0 0 0 1px rgba(160, 165, 210, 0.08);\n}\n\nbody.theme-dark {\n    color-scheme: dark;\n\n    /* =========================================================\n     Grayscale\n     어두운 순 -> 밝은 순\n     라벤더/블루그레이 기반\n     ========================================================= */\n\n    --color-00: #151520;\n    --color-05: #1a1a28;\n    --color-10: #20202f;\n    --color-20: #29293a;\n    --color-30: #353549;\n    --color-40: #56566c;\n    --color-50: #77778d;\n    --color-70: #a5a5b8;\n    --color-80: #d0d0dc;\n    --color-100: #f5f5f8;\n\n\n    /* =========================================================\n     Accent Colors\n     ========================================================= */\n\n    --color-red-rgb: 255, 107, 122;\n    --color-red: #ff6b7a;\n\n    --color-orange-rgb: 255, 166, 87;\n    --color-orange: #ffa657;\n\n    --color-yellow-rgb: 255, 209, 102;\n    --color-yellow: #ffd166;\n\n    --color-green-rgb: 72, 199, 116;\n    --color-green: #48c774;\n\n    --color-cyan-rgb: 76, 201, 240;\n    --color-cyan: #4cc9f0;\n\n    --color-blue-rgb: 112, 145, 255;\n    --color-blue: #7091ff;\n\n    --color-purple-rgb: 165, 158, 255;\n    --color-purple: #a59eff;\n\n    --color-pink-rgb: 255, 133, 162;\n    --color-pink: #ff85a2;\n\n\n    /* =========================================================\n     Backgrounds\n     ========================================================= */\n\n    /* 전체 앱 배경 */\n    --background-primary: #181824;\n\n    /* 사이드바 / 패널 */\n    --background-secondary: #20202f;\n\n    --sidebar-bg: #1c1c2a;\n\n    /* 컨텐츠 영역 */\n    --card-bg: #242434;\n\n    --card-hover-bg: #2a2a3d;\n\n    --card-border-color: rgba(255, 255, 255, 0.07);\n\n    --card-box-shadow:\n        0 4px 16px rgba(0, 0, 0, 0.22);\n\n\n    /* =========================================================\n     Buttons & Borders\n     ========================================================= */\n\n    --btn-bg: #2a2a3b;\n\n    --border-color: #353549;\n\n    --border-strong-color: #48485f;\n\n\n    /* =========================================================\n     Icons\n     ========================================================= */\n\n    --icon-color: #a5a5b8;\n\n    --indicator-color: #77778d;\n\n    --fill-color: #f0f0f5;\n\n    --icon-hover-color: #ffffff;\n\n    --icon-hover-bg: #343448;\n\n\n    /* =========================================================\n     Misc Components\n     ========================================================= */\n\n    --track-bg-color: #2a2a3a;\n\n    --badge-bg: #333347;\n\n    --badge-color: #c3c3d0;\n\n\n    /* =========================================================\n     Message Bubble\n     ========================================================= */\n\n    /* 일반 메시지 */\n    --bubble-bg: #242434;\n\n    --bubble-border-color: #38384d;\n\n    /* 사용자 메시지 */\n    --user-bubble-bg: #2b2b40;\n\n    --user-bubble-border-color: #41415a;\n\n    /* AI 메시지 */\n    --assistant-bubble-bg: #20202f;\n\n\n    /* =========================================================\n     Typography & Accent\n     ========================================================= */\n\n    --accent-color: #a59eff;\n\n    --accent-color-hover: #b8b2ff;\n\n    --text-accent: #f0f0f5;\n\n    --text-color: #e4e4ec;\n\n    --text-muted: #a0a0b2;\n\n    --text-italic: #858599;\n\n    --text-faint: #66667a;\n\n\n    /* =========================================================\n     Navigation\n     ========================================================= */\n\n    --nav-bg-hover: rgba(165, 158, 255, 0.10);\n\n    --nav-bg-active: rgba(165, 158, 255, 0.18);\n\n    --nav-text: #9292a5;\n\n    --nav-text-active: #c2bdff;\n\n\n    /* =========================================================\n     Input\n     ========================================================= */\n\n    --input-color: #e4e4ec;\n\n\n    /* =========================================================\n     Scroll / Selection\n     ========================================================= */\n\n    --scrollbar-thumb-color: #55556a;\n\n    --text-highlight-bg: rgba(165, 158, 255, 0.25);\n\n\n    /* =========================================================\n     Shadow\n     ========================================================= */\n\n    --shadow-sm:\n        0 1px 2px rgba(0, 0, 0, 0.25);\n\n    --shadow:\n        0 4px 12px rgba(0, 0, 0, 0.30),\n        0 0 0 1px rgba(255, 255, 255, 0.025);\n\n    --shadow-lg:\n        0 12px 32px rgba(0, 0, 0, 0.42),\n        0 0 0 1px rgba(255, 255, 255, 0.035);\n}"
}